# Copy to .env.production (used by `npm run build`) and/or .env.local (local dev).
# These values are baked into the site when you BUILD it, so rebuild and
# re-upload after changing them.

# Where the Netlify functions live (checkout, PayID orders, order confirmation).
# Your site is on GreenGeeks but the functions run on Netlify, so this is needed
# for the live site. Leave it unset under `netlify dev`.
# VITE_FUNCTIONS_BASE_URL=https://incomparable-genie-e06daa.netlify.app

# Where the PHP API lives (products.php). Not needed while the API is on the
# same domain as the site (the default is /api). Only set it if that changes.
VITE_API_BASE_URL=https://edweatherheadjewellery.com/api_test
